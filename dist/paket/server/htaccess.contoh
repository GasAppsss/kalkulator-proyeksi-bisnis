# Contoh untuk Apache (hosting bersama / cPanel). Ganti nama berkas ini menjadi .htaccess dan letakkan di folder kalkulator.
# Butuh mod_headers dan mod_mime. Ganti situsanda.com dengan domain situs Anda.

AddType application/manifest+json .webmanifest
AddDefaultCharset UTF-8

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
  Header always set Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; manifest-src 'self'; worker-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
  Header always set X-Frame-Options "DENY"

  # Halaman untuk iframe: hanya situs Anda yang boleh menanamnya
  <Files "iframe.html">
    Header always set Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors https://situsanda.com"
    Header always unset X-Frame-Options
  </Files>

  <FilesMatch "^(index\.html|iframe\.html|config(-iframe)?\.js|sw\.js|kpb\.js|kpb\.css|manifest\.webmanifest)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.woff2$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# Sembunyikan berkas yang bukan bagian halaman
<FilesMatch "^(README\.md|LISENSI-PIHAK-KETIGA\.txt|_headers)$">
  Require all denied
</FilesMatch>
