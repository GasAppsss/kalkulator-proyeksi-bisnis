# Contoh blok server Nginx untuk kalkulator proyeksi bisnis (HTTPS di-terminate di sini atau di depan Nginx).
# Salin, ganti kalkulator.situsanda.com dan situsanda.com, lalu letakkan di /etc/nginx/conf.d/.
# Catatan Nginx: add_header di dalam "location" menggantikan semua add_header di tingkat "server",
# jadi header keamanan diulang di setiap location yang mengatur header sendiri.

map $uri $kpb_cache {
    default                                   "public, max-age=3600";
    ~^/(index\.html|iframe\.html|config(-iframe)?\.js|sw\.js|kpb\.js|kpb\.css|manifest\.webmanifest)$   "no-cache";
    ~^/fonts/                                 "public, max-age=31536000, immutable";
    ~^/vendor/                                "public, max-age=2592000";
}

server {
    listen 443 ssl http2;
    server_name kalkulator.situsanda.com;
    # ssl_certificate dan ssl_certificate_key: sesuaikan dengan sertifikat Anda

    root /var/www/kalkulator;
    index index.html;
    charset utf-8;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;
    # Pastikan /etc/nginx/mime.types memuat "application/manifest+json webmanifest;" (Nginx versi baru sudah memuatnya).

    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()" always;
    add_header Cache-Control $kpb_cache always;

    # Halaman untuk iframe: hanya situs Anda yang boleh menanamnya
    location = /iframe.html {
        add_header Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors https://situsanda.com" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()" always;
        add_header Cache-Control $kpb_cache always;
    }

    # Semua yang lain: tidak boleh ditanam
    location / {
        try_files $uri $uri/ =404;
        add_header Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; manifest-src 'self'; worker-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'" always;
        add_header X-Frame-Options "DENY" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()" always;
        add_header Cache-Control $kpb_cache always;
    }

    # Berkas yang tidak perlu diakses publik
    location ~* ^/(README\.md|server/|LISENSI-PIHAK-KETIGA\.txt|_headers) { return 404; }
}
