# Header keamanan untuk Netlify dan Cloudflare Pages (berkas ini harus ada di akar folder yang diunggah).
# Ganti situsanda.com dengan domain situs Anda yang menanam kalkulator lewat iframe.
# Kebijakan di bawah sengaja ketat: semua skrip, gaya, dan font dimuat dari domain sendiri; tidak ada yang dimuat dari CDN.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; manifest-src 'self'; worker-src 'self'; base-uri 'none'; form-action 'none'

# Halaman mandiri: jangan boleh ditanam di situs lain
/
  Content-Security-Policy: frame-ancestors 'none'
  X-Frame-Options: DENY
  Cache-Control: no-cache
/index.html
  Content-Security-Policy: frame-ancestors 'none'
  X-Frame-Options: DENY
  Cache-Control: no-cache

# Halaman untuk iframe: hanya boleh ditanam oleh situs Anda
/iframe.html
  Content-Security-Policy: frame-ancestors https://situsanda.com
  Cache-Control: no-cache

# Berkas yang bisa Anda ubah: selalu cek ke server
/config.js
  Cache-Control: no-cache
/config-iframe.js
  Cache-Control: no-cache
/sw.js
  Cache-Control: no-cache
/kpb.js
  Cache-Control: no-cache
/kpb.css
  Cache-Control: no-cache
/manifest.webmanifest
  Cache-Control: no-cache

# Berkas yang tidak berubah: simpan lama
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
/vendor/*
  Cache-Control: public, max-age=2592000
